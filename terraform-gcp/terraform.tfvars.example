# Copy this file to terraform.tfvars and fill in your own project ID.
# terraform.tfvars is git-ignored - never commit it, though project_id
# alone isn't very sensitive.

project_id = "your-gcp-project-id-here"

# Optional - these are fallback values, only used if latest-tags.tf's live
# GHCR lookup ever fails (e.g. no versioned tag has been published yet).
# Normally you never need to touch these: latest-tags.tf queries GHCR
# directly on every apply and bootstraps onto whatever is actually newest,
# and Keel takes over tracking further updates after that - see the
# "Automatic redeployment" section in README.md.
#
# echoo_backend_tag     = "v0.0.9"
# echoo_frontend_tag    = "v0.0.9"
# violetboard_app_tag   = "v0.0.11"
# violetboard_web_tag   = "v0.0.11"